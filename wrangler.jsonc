{
  "$schema": "node_modules/wrangler/config-schema.json",
  // EDIT: a short name for your shop (lowercase, dashes). It becomes <name>.<you>.workers.dev
  "name": "my-shop",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",

  // Your landing page. Cloudflare serves it as-is; the Worker code only runs for the routes listed here.
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/thanks", "/download", "/stripe/webhook", "/subscribe"]
  },

  // Your own domain (GUIDE.md 3b: the agent asks you, and can help find and check one on Cloudflare).
  // Once it is on Cloudflare, put it here and remove the // at the start of the line.
  // "routes": [{ "pattern": "example.com", "custom_domain": true }],

  // ---- Stripe path only. On the Gumroad path, leave everything below as it is. ----
  "vars": {
    // One entry per product: the Stripe Payment Link id (plink_...) → the file in the bucket.
    // title is shown on the thank-you page; name is the file name the buyer's computer saves.
    // Sandbox and live links have different ids: going live means updating this.
    "PRODUCTS": {
      "plink_REPLACE_ME": { "file": "my-product.pdf", "name": "My-Product.pdf", "title": "My Product" }
    },
    "DOWNLOAD_DAYS": "30",
    "SUPPORT_EMAIL": "you@example.com",
    // Add-on C1: email buyers their link (GUIDE.md C1). Empty = off. A sender on your own domain, verified in Resend.
    "EMAIL_FROM": ""
  },
  // The private bucket that holds your product file. Nothing in it is public; only /download reads it.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "my-shop-files" }],
  // Secrets (never in this file): STRIPE_READ_KEY (B5); for C1 also STRIPE_WEBHOOK_SECRET and RESEND_API_KEY.

  // ---- Add-on C2: email signup form (either path). Remove the // to turn it on; the next deploy creates the database. ----
  // "d1_databases": [{ "binding": "SUBSCRIBERS", "database_name": "my-shop-subscribers", "migrations_dir": "migrations" }],
  // Secret for C2: TURNSTILE_SECRET (strongly recommended). Optional var: "SUBSCRIBE_HOURLY_CAP" (default 100).

  "observability": { "enabled": true }
}
